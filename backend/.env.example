# Neon PostgreSQL Connection URLs (Transaction pooled for runtime, direct for migrations)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Keys
JWT_ACCESS_SECRET="gusto_super_secret_access_key_min_32_chars_long_12345"
JWT_REFRESH_SECRET="gusto_super_secret_refresh_key_min_32_chars_long_67890"

# Rate Limiting & App Security
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081,gusto-app://oauth"

# External APIs
THE_MEAL_DB_API_URL="https://www.themealdb.com/api/json/v1/1"

# Resend Email Service (Password Reset OTP)
# Crie sua chave em https://resend.com
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Gusto <onboarding@resend.dev>"
